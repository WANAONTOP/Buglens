# BugLens AI frontend environment template.
# Copy to .env beside this file for a hosted backend. Never commit .env.
# Local development needs no file: the app defaults to http://127.0.0.1:8000.

# Public base URL of the deployed Modal backend (no trailing slash).
# Example: VITE_BUGLENS_API_URL=https://your-workspace--buglens-ai-api.modal.run
VITE_BUGLENS_API_URL=
