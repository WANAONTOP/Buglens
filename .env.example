# BugLens AI environment template.
# Copy to .env and fill in real values. Never commit .env.
#
#   Copy-Item .env.example .env

# Meta Model API (muse-spark-1.3, muse-wonder-1.0, sam-3.1)
META_API_KEY=
# Official base (used unless overridden below).
#META_API_BASE_URL=https://api.meta.ai/v1

# GitHub access for repository reads and PR creation
GITHUB_TOKEN=
GITHUB_REPO=

# Modal execution backend
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Baseten (optional integration)
BASETEN_API_KEY=

# Local development origins
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Application auth for /api/* (no default; generate with
# python -c "import secrets; print(secrets.token_hex(32))")
BUGLENS_API_TOKEN=

# Optional override for incident records + evidence artifacts
# (defaults to backend/data)
#BUGLENS_DATA_DIR=
